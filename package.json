{
  "name": "uniapp-project",
  "version": "1.0.0",
  "description": "A UniApp project",
  "main": "main.js",
  "scripts": {
    "dev:%PLATFORM%": "cross-env NODE_ENV=development UNI_PLATFORM=%PLATFORM% vue-cli-service uni-build --watch",
    "build:%PLATFORM%": "cross-env NODE_ENV=production UNI_PLATFORM=%PLATFORM% vue-cli-service uni-build",
    "serve": "npm run dev:h5",
    "build": "npm run build:h5",
    "build:app-plus": "node scripts/buildUni.js app-plus",
    "rename:apk": "node renameApk.js",
    "dev:h5": "cross-env NODE_ENV=development UNI_PLATFORM=h5 vue-cli-service uni-build --watch",
    "build:h5": "node scripts/buildUni.js h5"
  },
  "overrides": {
    "@achrinza/node-ipc": "10.1.11"
  },
  "dependencies": {
    "@dcloudio/uni-ui": "^1.5.8",
    "qrcode": "^1.5.4",
    "uqrcodejs": "^4.0.7",
    "uview-ui": "^2.0.38",
    "vue": "^2.6.14",
    "vue-i18n": "^8.28.2",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@dcloudio/types": "*",
    "@dcloudio/uni-app": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-app-plus": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-cli-i18n": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-cli-shared": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-h5": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-i18n": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-migration": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-mp-vue": "2.0.2-alpha-5000120260205002",
    "@dcloudio/uni-template-compiler": "2.0.2-alpha-5000120260205002",
    "@dcloudio/vue-cli-plugin-hbuilderx": "2.0.2-alpha-5000120260205002",
    "@dcloudio/vue-cli-plugin-uni": "2.0.2-alpha-5000120260205002",
    "@dcloudio/webpack-uni-mp-loader": "2.0.2-alpha-5000120260205002",
    "@dcloudio/webpack-uni-pages-loader": "2.0.2-alpha-5000120260205002",
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-import": "^1.13.5",
    "cache-loader": "^4.1.0",
    "copy-webpack-plugin": "^5.1.2",
    "cross-env": "^7.0.3",
    "file-loader": "^4.3.0",
    "html-webpack-plugin": "^3.2.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-rem-to-responsive-pixel": "^6.0.2",
    "sass": "^1.77.8",
    "thread-loader": "^2.1.3",
    "url-loader": "^2.3.0",
    "vue-template-compiler": "2.6.14",
    "webpack": "^4.47.0"
  },
  "browserslist": [
    "Android >= 4",
    "ios >= 9"
  ]
